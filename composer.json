{
    "name": "omnibase/press",
    "description": "Press for omnibase: quotes, hi-res photos with credits, biographies in three lengths - the press kit page an artist’s agency asks for.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.15|^3.0",
        "doctrine/doctrine-bundle": "^2.11|^3.0",
        "symfony/doctrine-bridge": "^6.4|^7.0|^8.0",
        "omnibridge/symfony": "^1.1",
        "omnisense/omnibase": "^5.1",
        "omnibase/admin": "^1.0",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0",
        "symfony/string": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {"Base\\Press\\": "./src"}
    },
    "autoload-dev": {
        "psr-4": {"Base\\Press\\Tests\\": "./tests"}
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
